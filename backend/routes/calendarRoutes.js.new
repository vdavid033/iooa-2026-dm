const express = require("express");
const router = express.Router();
const authJwt = require("../authJwt");
const { verifyTokenAdmin } = require("../authJwt");
const db = require("../db");

// Dohvati sve obaveze za prijavljenog korisnika
router.get("/sve-obaveze", authJwt.verifyTokenUser, (req, res) => {
  const sql = "SELECT * FROM obaveza";
  db.query(sql, (err, results) => {
    if (res.headersSent) return;
    if (err) {
      console.error("Gre��ka pri dohva��anju svih obaveza:", err);
      res.status(500).json({ error: "Gre��ka pri dohva��anju podataka." });
    } else {
      res.status(200).json(results);
    }
  });
});

// Dohvati obaveze za datonski raspon (tekući i naredni tjedan)
router.get("/obaveze-za-tjedan", authJwt.verifyTokenUser, (req, res) => {
  const danas = new Date();
  const pocetakTjedna = new Date(danas);
  pocetakTjedna.setDate(danas.getDate() - danas.getDay() + (danas.getDay() === 0 ? -6 : 1)); // Pocetak tjedna (ponedjeljak)
  
  const zavrsetakTjedna = new Date(pocetakTjedna);
  zavrsetakTjedna.setDate(pocetakTjedna.getDate() + 13); // 14 dana ukupno (tekuca + naredna)
  
  const formatDate = (date) => {
    return date.toISOString().split('T')[0];
  };
  
  const sql = "SELECT * FROM obaveza WHERE datum_obaveze BETWEEN ? AND ? ORDER BY datum_obaveze, vrijeme_pocetka";
  const values = [formatDate(pocetakTjedna), formatDate(zavrsetakTjedna)];
  
  db.query(sql, values, (err, results) => {
    if (res.headersSent) return;
    if (err) {
      console.error("Gre��ka pri dohva��anju obaveza za tjedan:", err);
      res.status(500).json({ error: "Gre��ka pri dohva��anju podataka." });
    } else {
      res.status(200).json(results);
    }
  });
});

// Dodaj novu obavezu
router.post("/unosObaveze", verifyTokenAdmin, (req, res) => {
  const {
    datum_obaveze,
    vrijeme_pocetka,
    opis_obaveze,
    lokacija,
    profesor,
    kolegij,
    fk_tip_obaveze,
  } = req.body;
  const sql =
    "INSERT INTO obaveza (datum_obaveze, vrijeme_pocetka, opis_obaveze, lokacija, profesor, kolegij, fk_tip_obaveze, fk_korisnika) VALUES (?, ?, ?, ?, ?, ?, ?, ?)";
  const values = [
    datum_obaveze,
    vrijeme_pocetka,
    opis_obaveze,
    lokacija,
    profesor,
    kolegij,
    fk_tip_obaveze,
    req.userId,
  ];
  db.query(sql, values, (err, result) => {
    if (res.headersSent) return;
    if (err) {
      console.error("Gre��ka pri unosu obaveze:", err);
      res.status(500).json({ error: "Neuspje��an unos obaveze." });
    } else {
      res
        .status(201)
        .json({ poruka: "Obaveza uspje��no unesena.", id: result.insertId });
    }
  });
});

// Obri��i obavezu
router.delete("/obaveza-brisanje/:id", authJwt.verifyTokenUser, (req, res) => {
  const { id } = req.params;
  const sql = "DELETE FROM obaveza WHERE id_obaveze = ?";
  db.query(sql, [id, req.userId], (err, results) => {
    if (res.headersSent) return;
    if (err) {
      console.error("Gre��ka pri brisanju obaveze:", err);
      res.status(500).json({ error: "Gre��ka pri brisanju obaveze." });
    } else if (results.affectedRows > 0) {
      res.status(200).json({ message: "Obaveza uspje��no obrisana." });
    } else {
      res.status(404).json({ message: "Obaveza nije prona�'ena." });
    }
  });
});

// Dohvati sve tipove obaveza
router.get("/tipoviObaveza", authJwt.verifyTokenUser, (req, res) => {
  const sql =
    "SELECT id_tipa_obaveze AS value, naziv_tipa_obaveze AS label FROM tip_obaveze";
  db.query(sql, (err, results) => {
    if (res.headersSent) return;
    if (err) {
      console.error("Gre��ka pri dohva��anju tipova obaveza:", err);
      res.status(500).json({ error: "Gre��ka pri dohva��anju tipova obaveza." });
    } else {
      res.status(200).json(results);
    }
  });
});

module.exports = router;